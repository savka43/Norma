{
  "name": "norma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts",
    "preview": "vite preview",
    "format": "prettier --write src vite.config.ts eslint.config.js index.html",
    "format:check": "prettier --check src vite.config.ts eslint.config.js index.html",
    "api:types": "npm exec --yes --package=typescript@5 --package=openapi-typescript@7.13.0 -- openapi-typescript http://127.0.0.1:8000/openapi.json -o src/shared/api/schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lexical/list": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/table": "0.53.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.3",
    "lexical": "0.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  }
}
