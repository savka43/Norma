# Copy to .env and set your own local password before starting Compose.
NORMA_DATABASE_HOST=127.0.0.1
NORMA_DATABASE_PORT=5432
NORMA_DATABASE_NAME=norma
NORMA_DATABASE_USER=norma
NORMA_DATABASE_PASSWORD=
NORMA_DATABASE_CONNECT_TIMEOUT_SECONDS=5
NORMA_READINESS_TIMEOUT_SECONDS=3
NORMA_SESSION_LIFETIME_SECONDS=28800
# Set to true when serving the application over HTTPS.
NORMA_SESSION_COOKIE_SECURE=false
