# Copy to .env and set your own local password before starting Compose.
NORMA_DATABASE_HOST=127.0.0.1
NORMA_DATABASE_PORT=5432
NORMA_DATABASE_NAME=norma
NORMA_DATABASE_USER=norma
NORMA_DATABASE_PASSWORD=
NORMA_DATABASE_CONNECT_TIMEOUT_SECONDS=5
NORMA_READINESS_TIMEOUT_SECONDS=3
NORMA_SESSION_LIFETIME_SECONDS=28800
# Set to true when serving the application over HTTPS.
NORMA_SESSION_COOKIE_SECURE=false
# Lifetime of an editor lease; renew it before expiry.
NORMA_DOCUMENT_LEASE_SECONDS=120
# PDF export requires LibreOffice; Docker image includes it.
NORMA_PDF_CONVERTER=libreoffice
NORMA_PDF_TIMEOUT_SECONDS=60
# Public test account: use only synthetic documents in a dedicated demo installation.
NORMA_PLAGIARISM_ENABLED=false
NORMA_PLAGIARISM_WSDL_URL=https://api.antiplagiat.ru:4959/apiCorp/testapi?wsdl
NORMA_PLAGIARISM_SITE_URL=https://testapi.antiplagiat.ru
NORMA_PLAGIARISM_LOGIN=
NORMA_PLAGIARISM_PASSWORD=
NORMA_PLAGIARISM_REQUEST_TIMEOUT_SECONDS=30
NORMA_PLAGIARISM_POLL_SECONDS=10
NORMA_PLAGIARISM_CHECK_TIMEOUT_SECONDS=3600
# Optional local cap. Leave blank to use the existing document storage budget.
NORMA_PLAGIARISM_MAX_TEXT_BYTES=
